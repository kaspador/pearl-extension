{
  "name": "pearl-extension",
  "version": "1.3.2",
  "private": true,
  "description": "Pearl Wallet — community-built Chrome extension for the Pearl blockchain (Proof-of-Useful-Work).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:firefox": "npm run build && node scripts/build-firefox.mjs",
    "package": "npm run build && cd dist && zip -r ../pearl-extension.zip .",
    "package:firefox": "npm run build:firefox && cd dist-firefox && zip -r ../pearl-wallet-firefox.zip .",
    "icons": "node scripts/rasterize-icons.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@scure/btc-signer": "^2.4.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.270",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.0",
    "globals": "^14.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
