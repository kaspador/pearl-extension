{
  "name": "pearl-extension",
  "version": "1.0.1",
  "private": true,
  "description": "Pearl Wallet — community-built Chrome extension for the Pearl blockchain (Proof-of-Useful-Work).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:firefox": "npm run build && node scripts/build-firefox.mjs",
    "package": "npm run build && cd dist && zip -r ../pearl-extension.zip .",
    "package:firefox": "npm run build:firefox && cd dist-firefox && zip -r ../pearl-wallet-firefox.zip .",
    "icons": "node scripts/rasterize-icons.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@scure/base": "^1.1.9",
    "@scure/bip32": "^1.5.0",
    "@scure/bip39": "^1.4.0",
    "@scure/btc-signer": "^2.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.27",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.270",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
